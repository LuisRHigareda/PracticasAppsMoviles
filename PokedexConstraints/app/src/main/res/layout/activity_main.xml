<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow_bg"
    tools:context=".MainActivity">

    <!-- Pokeball decorativa (fondo) -->

    <!-- Nombre -->

    <ImageView
        android:id="@+id/imgPokeball"
        android:layout_width="213dp"
        android:layout_height="294dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:alpha="0.85"
        android:contentDescription="@null"
        android:src="@drawable/pokeball"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pikachu"
        android:textColor="@color/white"
        android:textSize="44sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="44dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Número -->
    <TextView
        android:id="@+id/txtNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#025"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginStart="92dp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtName" />

    <!-- Estrella -->
    <ImageView
        android:id="@+id/imgStar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_star"
        android:contentDescription="@null"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card blanca grande (ahora como CardView) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="220dp"
        android:layout_marginBottom="18dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Contenedor interno para ordenar TODO dentro de la card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingTop="58dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <!-- Chip tipo (centrado) -->

            <!-- Columna izquierda: Altura -->

            <TextView
                android:id="@+id/chipType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip"
                android:text="Eléctrico"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.501"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/lblAltura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Altura"
                android:textColor="@color/red_label"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipType" />

            <TextView
                android:id="@+id/txtAltura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="0,4m"
                android:textColor="@color/text_dark"
                android:textSize="28sp"
                app:layout_constraintBaseline_toBaselineOf="@id/lblAltura"
                app:layout_constraintStart_toEndOf="@id/lblAltura" />

            <!-- Columna izquierda: Peso -->

            <TextView
                android:id="@+id/lblPeso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="Peso"
                android:textColor="@color/red_label"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblAltura" />

            <TextView
                android:id="@+id/txtPeso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="6,0kg"
                android:textColor="@color/text_dark"
                android:textSize="28sp"
                app:layout_constraintBaseline_toBaselineOf="@id/lblPeso"
                app:layout_constraintStart_toEndOf="@id/lblPeso" />


            <TextView
                android:id="@+id/lblHabilidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="56dp"
                android:text="Habilidad"
                android:textColor="@color/red_label"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipType" />

            <TextView
                android:id="@+id/txtHabilidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Elec. Estática"
                android:textColor="@color/text_dark"
                android:textSize="28sp"
                app:layout_constraintStart_toStartOf="@id/lblHabilidad"
                app:layout_constraintTop_toBottomOf="@id/lblHabilidad" />

            <TextView
                android:id="@+id/txtDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="Cuando se enfada, este Pokémon descarga la energía que almacena en el interior de las bolsas de las mejillas."
                android:textColor="@color/text_gray"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblPeso" />

            <ImageView
                android:id="@+id/imgArbok"
                android:layout_width="86dp"
                android:layout_height="73dp"
                android:layout_marginStart="44dp"
                android:layout_marginBottom="36dp"
                android:contentDescription="@null"
                android:src="@drawable/arbok"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/imgRaichu"
                android:layout_width="86dp"
                android:layout_height="90dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="24dp"
                android:contentDescription="@null"
                android:src="@drawable/raichu"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtPrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="44dp"
                android:layout_marginBottom="8dp"
                android:text="Arbok N.º 0024"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:layout_marginBottom="8dp"
                android:text="Raichu N.º 0026"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/btnLeft"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="0dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_left"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/btnRight"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Pikachu encima de la card (por fuera, para que "salga") -->
    <ImageView
        android:id="@+id/imgPokemon"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginTop="-110dp"
        android:contentDescription="@null"
        android:src="@drawable/pikachu"
        app:layout_constraintEnd_toEndOf="@id/card"
        app:layout_constraintHorizontal_bias="0.548"
        app:layout_constraintStart_toStartOf="@id/card"
        app:layout_constraintTop_toTopOf="@id/card" />

</androidx.constraintlayout.widget.ConstraintLayout>

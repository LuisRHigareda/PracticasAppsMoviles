<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow_bg"
    tools:context=".MainActivity">

    <!-- Pokeball decorativa (fondo) -->
    <ImageView
        android:id="@+id/imgPokeball"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:alpha="0.85"
        android:contentDescription="@null"
        android:src="@drawable/pokeball"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="-40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Nombre -->
    <TextView
        android:id="@+id/txtName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pikachu"
        android:textColor="@color/white"
        android:textSize="44sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Número -->
    <TextView
        android:id="@+id/txtNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#025"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginStart="92dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtName" />

    <!-- Estrella -->
    <ImageView
        android:id="@+id/imgStar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/star"
        android:contentDescription="@null"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card blanca grande -->
    <View
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card_round"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="210dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pikachu sobre la card (encimado) -->
    <ImageView
        android:id="@+id/imgPokemon"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/pikachu"
        android:contentDescription="@null"
        android:layout_marginTop="-90dp"
        app:layout_constraintTop_toTopOf="@id/card"
        app:layout_constraintStart_toStartOf="@id/card"
        app:layout_constraintEnd_toEndOf="@id/card" />

    <!-- Chip tipo (Eléctrico) -->
    <TextView
        android:id="@+id/chipType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:background="@drawable/bg_chip"
        android:text="Eléctrico"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/card"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="@id/card"
        app:layout_constraintTop_toTopOf="@id/card" />

    <!-- Altura -->

    <TextView
        android:id="@+id/lblAltura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:text="Altura"
        android:textColor="@color/red_label"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/card"
        app:layout_constraintTop_toBottomOf="@id/chipType" />

    <!-- Peso -->

    <TextView
        android:id="@+id/txtAltura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="0,4m"
        android:textColor="@color/text_dark"
        android:textSize="30sp"
        app:layout_constraintBaseline_toBaselineOf="@id/lblAltura"
        app:layout_constraintStart_toEndOf="@id/lblAltura" />

    <TextView
        android:id="@+id/lblPeso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:text="Peso"
        android:textColor="@color/red_label"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/card"
        app:layout_constraintTop_toBottomOf="@id/lblAltura" />

    <TextView
        android:id="@+id/txtPeso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6,0kg"
        android:textColor="@color/text_dark"
        android:textSize="30sp"
        android:layout_marginStart="26dp"
        app:layout_constraintStart_toEndOf="@id/lblPeso"
        app:layout_constraintBaseline_toBaselineOf="@id/lblPeso" />

    <!-- Habilidad -->
    <TextView
        android:id="@+id/lblHabilidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Habilidad"
        android:textColor="@color/red_label"
        android:textStyle="bold"
        android:textSize="26sp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="44dp"
        app:layout_constraintEnd_toEndOf="@id/card"
        app:layout_constraintTop_toBottomOf="@id/chipType" />

    <TextView
        android:id="@+id/txtHabilidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Elec. Estática"
        android:textColor="@color/text_dark"
        android:textSize="30sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/lblHabilidad"
        app:layout_constraintStart_toStartOf="@id/lblHabilidad" />
</androidx.constraintlayout.widget.ConstraintLayout>
